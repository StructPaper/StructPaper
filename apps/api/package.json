{
  "name": "@structpaper/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/apps/api/src/main.js",
    "test": "vitest run",
    "openapi:generate": "tsx src/scripts/generate-openapi.ts",
    "depcruise": "depcruise --config .dependency-cruiser.js src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@casl/ability": "^7.1.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-fastify": "^10.4.15",
    "@node-rs/argon2": "^2.2.2",
    "@structpaper/contracts": "workspace:*",
    "@structpaper/db": "workspace:*",
    "fastify": "^4.28.1",
    "immer": "^10.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "dependency-cruiser": "^18.7.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
