{
  "name": "structpaper-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @structpaper/web build",
    "dev:web": "pnpm --filter @structpaper/web dev",
    "dev:api": "pnpm --filter @structpaper/api dev",
    "dev:worker": "pnpm --filter @structpaper/worker dev",
    "db:migrate": "pnpm --filter @structpaper/db migrate",
    "db:seed": "pnpm --filter @structpaper/db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "depcruise": "depcruise --config .dependency-cruiser.js packages apps",
    "deps:check": "pnpm depcruise --config .dependency-cruiser.js packages apps",
    "verify": "tsx scripts/verify-all.ts",
    "spike:engine": "tsx scripts/spikes/latex-engine-spike.ts",
    "warmup:latex": "tsx --tsconfig apps/web/tsconfig.json scripts/latex-warmup.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^8.57.1",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "vitest": "^2.1.9",
    "yaml": "^2.9.1"
  }
}
