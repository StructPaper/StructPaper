# .env for docker-compose.prod.yml. Copy it NEXT TO the compose file, as ".env", in each VM folder
# (e.g. ~/infra/app-cheban-prod/.env and ~/infra/app-cheban-staging/.env). Never commit real values.
# Hostnames = container/service names of Postgres/MinIO on the `infra` network.

# Images to pull and run, built elsewhere (e.g. by a GitLab runner) and pushed to a registry.
# Full reference = <registry>/<path>/<name>:<tag>. Use a different tag per environment
# (e.g. :staging / :prod, or the commit SHA) so production never picks up an untested image.
# The VM must be logged in to the registry once: docker login <registry>
DB_INIT_IMAGE=<registry>/<path>/cheban-db-init:<tag>
API_IMAGE=<registry>/<path>/cheban-api:<tag>
WORKER_IMAGE=<registry>/<path>/cheban-worker:<tag>
WEB_IMAGE=<registry>/<path>/cheban-web:<tag>

DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/<db>

S3_ENDPOINT=http://<minio-host>:9000
S3_ACCESS_KEY=<minio-user>
S3_SECRET_KEY=<minio-password>
S3_BUCKET=<bucket>
S3_REGION=us-east-1

# Seed admin (first run). Use a strong password.
INITIAL_ADMIN_EMAIL=admin@yourdomain
INITIAL_ADMIN_PASSWORD=

# Signing key for login tokens (JWT). >= 32 chars: openssl rand -hex 32
# Use a DIFFERENT value per environment; changing it logs everyone out.
JWT_SECRET=

# Public address users open the web at (used for links in emails, and the CORS allow-list)
APP_URL=https://cheban.example.com
CORS_ORIGIN=https://cheban.example.com

# Host ports MUST differ between environments running on the same VM.
#   production: 3000 / 3001      staging: 3100 / 3101
BIND_ADDR=127.0.0.1
WEB_PORT=3000
API_PORT=3001
