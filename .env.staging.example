# Copy to .env.staging.local (git-ignored) and fill in. Postgres needs VPN.
DATABASE_URL=postgresql://<user>:<password>@<postgres-ip>:5432/<db>

S3_ENDPOINT=https://<minio-host>
S3_ACCESS_KEY=<user>
S3_SECRET_KEY=<password>
S3_BUCKET=<bucket>
S3_REGION=us-east-1

JWT_SECRET=change-me-min-32-chars-long-xxxxxxxx
JWT_REFRESH_SECRET=change-me-min-32-chars-long-yyyyyyyy
CORS_ORIGIN=http://localhost:3000

# Only used by the db-init profile
INITIAL_ADMIN_EMAIL=admin@structpaper.org
INITIAL_ADMIN_PASSWORD=
