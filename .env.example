# ==============================================================================
# StructPaper Environment Variables
# Copy to .env for local development or set in target deployment environment
# ==============================================================================

# Node Environment Mode
NODE_ENV=development
PORT=4000

# PostgreSQL Database Configuration
# Local Docker Compose defaults: user=structpaper, password=structpaper, db=structpaper, port=5432
DATABASE_URL=postgresql://structpaper:structpaper@localhost:5432/structpaper
POSTGRES_USER=structpaper
POSTGRES_PASSWORD=structpaper
POSTGRES_DB=structpaper
POSTGRES_PORT=5432

# MinIO / S3 Object Storage Configuration
# Local Docker Compose defaults: endpoint=http://localhost:9000, console=http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=structpaper-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_SECRET=dev-jwt-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-minimum-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial System Admin Bootstrap
INITIAL_ADMIN_EMAIL=admin@structpaper.org
INITIAL_ADMIN_PASSWORD=AdminPassword123!

# Client & CORS
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Email Delivery (DevMailDriver logs activation/reset URLs to console when SMTP_HOST is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@structpaper.org
